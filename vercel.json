{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "hit.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "icon.webp",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/hit.mp3", "dest": "/hit.mp3" },
    { "src": "/icon.webp", "dest": "/icon.webp" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
